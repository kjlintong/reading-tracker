# 复制本文件为 .env 并填入自己的密钥：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。
#
# 两个密钥都是可选的：
# - WEREAD_API_KEY  缺省时微信读书导入不可用，其余功能（本地库、CSV 导入、
#                   端侧 OCR、统计、图表）全部正常
# - LLM_API_KEY     缺省时元数据兜底补全与 AI 报告不可用，同上其余功能正常

# 微信读书官方 Agent 网关 Key：扫码 https://weread.qq.com/r/weread-skills 获取（wrk- 开头）
WEREAD_API_KEY=

# 大模型（OpenAI 兼容协议），用于元数据兜底补全与定期阅读报告
LLM_API_KEY=
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=sensenova-6.8-flash-lite
