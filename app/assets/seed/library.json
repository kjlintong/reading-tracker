  "notes": [
    {
      "id": "sample-note-000",
      "type": "highlight",
      "content": "未加思索的行动不是行动，而是习惯。",
      "chapter": null,
      "pageAt": null,
      "source": "notion",
      "bookTitle": "沉思录",
      "bookAuthor": "马可·奥勒留",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-001",
      "type": "highlight",
      "content": "你有力量支配自己的内心，外部事件你无能为力。",
      "chapter": null,
      "pageAt": 41,
      "source": "notion",
      "bookTitle": "沉思录",
      "bookAuthor": "马可·奥勒留",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-002",
      "type": "thought",
      "content": "无知之幕是最干净的思想实验，也是最能暴露直觉的设计。",
      "chapter": null,
      "pageAt": null,
      "source": "notion",
      "bookTitle": "正义论",
      "bookAuthor": "约翰·罗尔斯",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-003",
      "type": "highlight",
      "content": "没有人应因为社会的偶然因素而受益或受损。",
      "chapter": null,
      "pageAt": 32,
      "source": "notion",
      "bookTitle": "正义论",
      "bookAuthor": "约翰·罗尔斯",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-004",
      "type": "highlight",
      "content": "反过来想，总是反过来想。",
      "chapter": null,
      "pageAt": 78,
      "source": "notion",
      "bookTitle": "穷查理宝典",
      "bookAuthor": "查理·芒格",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-005",
      "type": "thought",
      "content": "给岁月以文明，而不是给文明以岁月。",
      "chapter": null,
      "pageAt": null,
      "source": "notion",
      "bookTitle": "三体",
      "bookAuthor": "刘慈欣",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-006",
      "type": "highlight",
      "content": "弱小和无知不是生存的障碍，傲慢才是。",
      "chapter": null,
      "pageAt": 214,
      "source": "notion",
      "bookTitle": "三体",
      "bookAuthor": "刘慈欣",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-007",
      "type": "highlight",
      "content": "理解地方政府的行为逻辑，是理解中国经济的前提。",
      "chapter": null,
      "pageAt": null,
      "source": "notion",
      "bookTitle": "置身事内",
      "bookAuthor": "兰小欢",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-008",
      "type": "highlight",
      "content": "没有反馈的重复练习不会带来进步，只会让错误固化。",
      "chapter": null,
      "pageAt": 23,
      "source": "notion",
      "bookTitle": "刻意练习",
      "bookAuthor": "安德斯·艾利克森",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-009",
      "type": "thought",
      "content": "动态规划的难点不在写法，而在正确描述子问题的状态。",
      "chapter": null,
      "pageAt": null,
      "source": "notion",
      "bookTitle": "算法导论",
      "bookAuthor": "Thomas H. Cormen",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-010",
      "type": "highlight",
      "content": "想象的共同神话，是人类协作的真正基础设施。",
      "chapter": null,
      "pageAt": 96,
      "source": "notion",
      "bookTitle": "人类简史",
      "bookAuthor": "尤瓦尔·赫拉利",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-011",
      "type": "review",
      "content": "重读之后才理解，这本书危险的地方在于它太像说明书。",
      "chapter": null,
      "pageAt": null,
      "source": "notion",
      "bookTitle": "1984",
      "bookAuthor": "乔治·奥威尔",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-012",
      "type": "highlight",
      "content": "应当想象西西弗是幸福的。",
      "chapter": null,
      "pageAt": 38,
      "source": "notion",
      "bookTitle": "西西弗神话",
      "bookAuthor": "加缪",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-013",
      "type": "thought",
      "content": "先描述事实再谈感受，指责的冲动就有了落点。",
      "chapter": null,
      "pageAt": null,
      "source": "notion",
      "bookTitle": "非暴力沟通",
      "bookAuthor": "马歇尔·卢森堡",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-014",
      "type": "highlight",
      "content": "舒适区之外的练习才产生进步，这一点在多数领域都被低估。",
      "chapter": null,
      "pageAt": 105,
      "source": "notion",
      "bookTitle": "刻意练习",
      "bookAuthor": "安德斯·艾利克森",
      "createdAt": "2026-09-30T00:00:00.000Z"
    },
    {
      "id": "sample-note-015",
      "type": "review",
      "content": "三十年后重读仍然成立，说明结构化的工程经验不靠框架续命。",
