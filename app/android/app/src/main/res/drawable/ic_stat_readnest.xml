<?xml version="1.0" encoding="utf-8"?>
<!--
  通知小图标（status bar icon）。

  Android 的通知小图标是**单色剪影**：系统会把整张图按 alpha 通道当模板渲染，
  所有非透明像素都变成同一种颜色。原来这里填的是 `@mipmap/ic_launcher`——
  那是**彩色启动图标**，在通知栏里会被压成一块白方块（深色主题下是黑方块），
  少数 ROM 还会因为图标不是合法模板而整条通知不显示。

  所以必须单独给一张纯白剪影：展开的书页 + 书脊缺口，
  24dp 下仍然认得出是「书」，和 App 的调性一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 左页 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.2,4.9 C9.5,3.7 6.9,3.1 3.2,3.1 L3.2,18.6 C6.9,18.6 9.5,19.2 11.2,20.4 Z" />
    <!-- 右页 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.8,4.9 C14.5,3.7 17.1,3.1 20.8,3.1 L20.8,18.6 C17.1,18.6 14.5,19.2 12.8,20.4 Z" />
</vector>
